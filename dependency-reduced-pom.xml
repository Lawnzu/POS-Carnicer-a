<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.dontoribio</groupId>
  <artifactId>pos-dontoribio</artifactId>
  <name>Don Toribio POS</name>
  <version>1.0.0-SNAPSHOT</version>
  <description>Software de Punto de Venta y control de pesaje para Comercializadora de Carnes Don Toribio S.A.C.</description>
  <build>
    <finalName>pos-dontoribio</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${mainClass}</mainClass>
          <launcher>pos-dontoribio</launcher>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer />
                <transformer>
                  <mainClass>com.dontoribio.pos.Launcher</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <mainClass>com.dontoribio.pos.MainApp</mainClass>
    <jbcrypt.version>0.4</jbcrypt.version>
    <mainModuleName>com.dontoribio.pos</mainModuleName>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.4</javafx.version>
    <jserialcomm.version>2.10.4</jserialcomm.version>
    <controlsfx.version>11.2.1</controlsfx.version>
    <hikaricp.version>5.1.0</hikaricp.version>
    <maven.compiler.source>17</maven.compiler.source>
    <atlantafx.version>2.0.1</atlantafx.version>
    <maven.compiler.target>17</maven.compiler.target>
    <postgresql.version>42.7.4</postgresql.version>
  </properties>
</project>
